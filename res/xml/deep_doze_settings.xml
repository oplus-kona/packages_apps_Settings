<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/deep_doze_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="deep_doze_main_switch"
        android:title="@string/deep_doze_title" />

    <com.android.settingslib.widget.BannerMessagePreference
        android:key="deep_doze_banner"
        android:title="@string/deep_doze_banner_title"
        android:summary="@string/deep_doze_banner_summary" />

    <PreferenceCategory
        android:key="deep_doze_sleep_category"
        android:title="@string/deep_doze_sleep_category">

        <SwitchPreferenceCompat
            android:key="deep_doze_schedule_mode"
            android:title="@string/deep_doze_schedule_mode_title"
            android:summary="@string/deep_doze_schedule_mode_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="deep_doze_pre_alarm_warming"
            android:title="@string/deep_doze_pre_alarm_title"
            android:summary="@string/deep_doze_pre_alarm_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="deep_doze_repeat_callers"
            android:title="@string/deep_doze_repeat_callers_title"
            android:summary="@string/deep_doze_repeat_callers_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="deep_doze_metrics_category"
        android:title="@string/deep_doze_status_category">

        <Preference
            android:key="deep_doze_timeline"
            android:title="@string/deep_doze_timeline_title"
            android:icon="@drawable/ic_settings_date_time"
            android:selectable="false" />

        <Preference
            android:key="deep_doze_latency"
            android:title="@string/deep_doze_latency_title"
            android:icon="@drawable/ic_battery_saver_accent_24dp"
            android:selectable="false" />

        <Preference
            android:key="deep_doze_drain"
            android:title="@string/deep_doze_drain_title"
            android:icon="@drawable/ic_battery_alert_24dp"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="deep_doze_disturbance_category"
        android:title="@string/deep_doze_disturbance_category">

        <Preference
            android:key="deep_doze_disturbance_empty"
            android:summary="@string/deep_doze_disturbance_empty"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="deep_doze_exceptions_category"
        android:title="@string/deep_doze_exceptions_category">

        <Preference
            android:key="deep_doze_calls_exception"
            android:title="Phone &amp; Telecom"
            android:summary="Incoming calls and emergency services bypass idle suspension"
            android:icon="@drawable/ic_call_grey_24dp"
            android:selectable="false" />

        <Preference
            android:key="deep_doze_sms_exception"
            android:title="SMS &amp; Messaging"
            android:summary="Default SMS provider permitted to deliver messages"
            android:icon="@drawable/ic_zen_mode_people_messages"
            android:selectable="false" />

        <Preference
            android:key="deep_doze_alarms_exception"
            android:title="Clock &amp; Alarms"
            android:summary="Timers and alarms trigger as scheduled without delay"
            android:icon="@drawable/ic_zen_mode_sound_alarms"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="deep_doze_radios_category"
        android:title="@string/deep_doze_radios_category">

        <Preference
            android:key="deep_doze_radios_info"
            android:summary="@string/deep_doze_radios_summary"
            android:icon="@drawable/ic_wifi_signal_4"
            android:selectable="false" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="deep_doze_footer"
        android:title="@string/deep_doze_summary"
        android:selectable="false"
        settings:searchable="false" />
</PreferenceScreen>
